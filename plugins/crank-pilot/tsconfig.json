{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "/page/*": ["./page/*"] },
    "skipLibCheck": true,
    "types": []
  },
  "include": ["page/**/*.js"],
  "exclude": ["page/vendor"]
}
