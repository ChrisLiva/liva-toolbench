#!/usr/bin/env python3
"""crank-pilot: the interactive page's command. `crank-pilot --help` lists the verbs."""

import os
import sys

if sys.version_info < (3, 11):
    sys.exit(
        f"crank-pilot needs Python 3.11 or newer; this is {sys.version.split()[0]}."
    )

if os.name == "nt":
    sys.exit("crank-pilot runs on macOS and Linux.")

from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from pilot.cli import main

if __name__ == "__main__":
    sys.exit(main())
